    },
    {
      "name": "task_name",
      "type": "string"
    },
    {
      "name": "task_description",
      "type": "string"
    },
    {
      "name": "task_completed",
      "type": "boolean"
    },
    {
      "name": "audit_enabled",
      "type": "boolean"
    },
    {
      "name": "audit_passed",
      "type": "boolean"
    },
    {
      "name": "audit_fail_reason",
      "type": "string"
    },
    {
      "name": "task_context",
      "type": "array"
    },
    {
      "name": "task_reference",
      "type": "array"
    },
    {
      "name": "task_mandatory",
      "type": "boolean"
    }
  ],
